# Zip the GCP function code
data "archive_file" "gcp_func_zip" {
  type        = "zip"
  source_dir  = "${path.module}/src/gcp_function"
  output_path = "${path.module}/dist/gcp_function.zip"
}

# Bucket to store the zipped code
resource "google_storage_bucket" "source_bucket" {
  name     = "${var.app_name_prefix}-gcp-func-source-${random_string.suffix.result}"
  location = "US"
  uniform_bucket_level_access = true
}

resource "google_storage_bucket_object" "source_object" {
  name   = "source.zip"
  bucket = google_storage_bucket.source_bucket.name
  source = data.archive_file.gcp_func_zip.output_path
}

# The GCP function
resource "google_cloudfunctions2_function" "main" {
  name     = "${var.app_name_prefix}-get-user-data"
  location = var.gcp_region

  build_config {
    runtime     = "python313"
    entry_point = "get_user_data"
    source {
      storage_source {
        bucket = google_storage_bucket.source_bucket.name
        object = google_storage_bucket_object.source_object.name
      }
    }
  }

  service_config {
    max_instance_count = 1
    ingress_settings   = "ALLOW_ALL"
    service_account_email = google_service_account.main.email
  }
  depends_on = [ google_project_service.cloudfunctions_api, google_project_service.cloudbuild_api, google_project_service.run_api ]
}

# Allow public invocation of the GCP function (secured by IAM)
resource "google_cloud_run_service_iam_member" "invoker" {
  location = google_cloudfunctions2_function.main.location
  service  = google_cloudfunctions2_function.main.name
  role     = "roles/run.invoker"
  member   = "allUsers"
}

# GCP Service Account for the Lambda to impersonate
resource "google_service_account" "main" {
  account_id   = "${var.app_name_prefix}-sa"
  display_name = "Service Account for AWS Lambda Federation"
}

# Pool of external identities
resource "google_iam_workload_identity_pool" "main" {
  workload_identity_pool_id = "${var.app_name_prefix}-pool"
  display_name              = "Identity Pool for AWS"
}

# Provider within the pool, specifically for AWS
resource "google_iam_workload_identity_pool_provider" "aws" {
  workload_identity_pool_id = google_iam_workload_identity_pool.main.workload_identity_pool_id
  workload_identity_pool_provider_id = "aws-provider"
  aws {
    account_id = data.aws_caller_identity.current.account_id
  }
}

# The AWS -> GCP trust relationship
resource "google_service_account_iam_member" "federation_trust" {
  service_account_id = google_service_account.main.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "principalSet://iam.googleapis.com/${google_iam_workload_identity_pool.main.name}/attribute.aws_role/arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/${aws_iam_role.lambda_exec.name}"
}

resource "google_project_service" "cloudfunctions_api" {
  project            = var.gcp_project_id
  service            = "cloudfunctions.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "cloudbuild_api" {
  project            = var.gcp_project_id
  service            = "cloudbuild.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "run_api" {
  project            = var.gcp_project_id
  service            = "run.googleapis.com"
  disable_on_destroy = false
}
